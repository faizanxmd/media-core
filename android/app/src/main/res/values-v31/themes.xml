<resources>
    <!-- Android 12+: the system's splash is only the app's dark ground; the app then shows its wordmark (Root.Intro) -->
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_none</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="Theme.Player" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
