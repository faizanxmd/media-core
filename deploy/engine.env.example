# ~/.config/media-core/engine.env: the server's settings, one KEY=value per line.
# `media-core-engine install` and `setup` write the common ones; the site's Settings > Server does too.
# A real environment variable wins over this file.

# The library: Movies, TV Shows and Music go in it (default: ~/Media)
#MEDIA_CORE_LIBRARY=/srv/media

# The server's name, as the apps and the site show it (default: this computer's name)
#MEDIA_CORE_NAME=Living room

# The site's port, and the apps' port (which also answers the apps' search on the home network)
#MEDIA_CORE_LISTEN=:8780
#MEDIA_CORE_PLAYER_LISTEN=:8790

# A second copy of the nightly backup: a USB stick or a network share (default: none)
#MEDIA_CORE_BACKUP_DIR=/mnt/backup

# More host names the server may be opened by, besides IP addresses, one-word names and .local/.lan
#MEDIA_CORE_HOSTS=media.example.org

# dovi_tool, for Dolby Vision profile 7 (default: on PATH, else ~/.local/bin/dovi_tool)
#MEDIA_CORE_DOVI_TOOL=/usr/local/bin/dovi_tool
