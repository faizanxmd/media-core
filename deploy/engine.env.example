# Copy to ~/.config/media-core/engine.env (or $XDG_CONFIG_HOME/media-core/engine.env)
# and uncomment any setting you want to override. Environment variables take precedence.

# Library root directory (default: /srv/data/media)
#MEDIA_CORE_LIBRARY=/srv/data/media

# Server display name shown in the UI and apps (default: short hostname, or "Media Core")
#MEDIA_CORE_NAME=Media Core

# Admin web UI and API listen address (default: :8780)
#MEDIA_CORE_LISTEN=:8780

# Player API listen address and UDP discovery port (default: :8790)
#MEDIA_CORE_PLAYER_LISTEN=:8790

# Public or remote host name the apps can use away from home (default: Tailscale MagicDNS if available)
#MEDIA_CORE_PUBLIC_HOST=

# Path to dovi_tool for Dolby Vision profile conversion (default: dovi_tool on PATH, else ~/.local/bin/dovi_tool)
#MEDIA_CORE_DOVI_TOOL=/usr/local/bin/dovi_tool
