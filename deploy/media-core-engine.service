[Unit]
Description=Media Core engine: downloads into the library and serves the site and the apps
After=network-online.target media-core-aria2.service
Wants=media-core-aria2.service

[Service]
ExecStart=%h/.local/bin/media-core-engine serve
Restart=always
RestartSec=3
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0002
# post-processing children (ffmpeg, 7z) may be mid-run on restart; the app
# picks those jobs up again, so a quick stop is fine
TimeoutStopSec=10
# a stream made while a title plays keeps up to about 150M of pieces in memory, and its
# ffmpegs and the file pages they read count here too (engine/stream.go)
MemoryHigh=800M

[Install]
WantedBy=default.target
