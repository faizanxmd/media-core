[Unit]
Description=Media Core download engine (aria2 RPC on 127.0.0.1:6800)

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/media-core
ExecStartPre=/usr/bin/touch %h/.local/share/media-core/aria2.session
ExecStart=/usr/bin/aria2c --conf-path=%h/.config/media-core/aria2.conf
Restart=on-failure
RestartSec=5
# downloads are network-bound; keep them out of playback's way on CPU and disk
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
UMask=0002

[Install]
WantedBy=default.target
